+// servingPackageBinder applies the same project-config/package-map merge as
+// run and plan. It writes catalog-resolved definitions into both registries so
+// planning and invocation cannot disagree about which package binding won.
+type servingPackageBinder struct {
+	workspaceRoot    string
+	projectRequires  []*schema.PackageRequirement
+	projectToolPaths []string
+	plannerRegistry  *plannerToolRegistry
+	runtimeRegistry  *internaltool.OverlayRegistry
+}
+
+func newServingPackageBinder(
+	workspaceRoot string,
+	packageMapPath string,
+	plannerRegistry *plannerToolRegistry,
+	runtimeRegistry *internaltool.OverlayRegistry,
+) (*servingPackageBinder, error) {
+	projectConfig, err := loadProjectConfig(workspaceRoot)
+	if err != nil {
+		return nil, err
+	}
+
+	var projectRequires []*schema.PackageRequirement
+	var projectToolPaths []string
+	if projectConfig != nil {
+		projectRequires = projectConfig.Requires
+		projectToolPaths = projectConfig.ToolPaths
+	}
+
+	var overrideRequires []*schema.PackageRequirement
+	var overrideToolPaths []string
+	if packageMapPath != "" {
+		if !filepath.IsAbs(packageMapPath) {
+			packageMapPath = filepath.Join(workspaceRoot, packageMapPath)
+		}
+		packageMap, mapErr := loadPackageMap(packageMapPath)
+		if mapErr != nil {
+			return nil, mapErr
+		}
+		if packageMap != nil {
+			overrideRequires = packageMap.Requires
+			overrideToolPaths = packageMap.ToolPaths
+		}
+	}
+
+	mergedRequires, _ := mergePackageBindings(projectRequires, overrideRequires)
+	return &servingPackageBinder{
+		workspaceRoot:    workspaceRoot,
+		projectRequires:  mergedRequires,
+		projectToolPaths: mergeToolPaths(projectToolPaths, overrideToolPaths),
+		plannerRegistry:  plannerRegistry,
+		runtimeRegistry:  runtimeRegistry,
+	}, nil
+}
+
+func (b *servingPackageBinder) bind(runbook *parser.ParsedRunbook) error {
+	if runbook == nil || runbook.Runbook == nil || len(runbook.Runbook.ToolRefs) == 0 {
+		return nil
+	}
+
+	catalog, catalogErrs := adapter.BuildPackageCatalog(adapter.PackageCatalogOptions{
+		WorkspaceRoot:    b.workspaceRoot,
+		Builtins:         internaltool.NewBuiltinRegistry().All(),
+		ProjectRequires:  b.projectRequires,
+		ProjectToolPaths: b.projectToolPaths,
+	}, runbook.Source, runbook.Runbook.Requires)
+	fatalCatalog, catalogWarnings := errkit.SplitWarnings(catalogErrs)
+	if len(fatalCatalog) > 0 {
+		return fmt.Errorf("build package catalog: %v", fatalCatalog)
+	}
+	for _, warning := range catalogWarnings {
+		fmt.Fprintf(os.Stderr, "gert serve: warning: %v\n", warning)
+	}
+
+	defs, bindErrs := adapter.ResolveToolRefsViaCatalog(catalog, runbook.Source, runbook.Runbook.ToolRefs)
+	fatalBindings, bindingWarnings := errkit.SplitWarnings(bindErrs)
+	if len(fatalBindings) > 0 {
+		return fmt.Errorf("resolve package bindings: %v", fatalBindings)
+	}
+	for _, warning := range bindingWarnings {
+		fmt.Fprintf(os.Stderr, "gert serve: warning: %v\n", warning)
+	}
+
+	for _, def := range defs {
+		b.runtimeRegistry.Override(def)
+		b.plannerRegistry.Override(def)
+	}
+	return nil
+}
+
+type packageBoundPlanner struct {
+	delegate plannerpkg.Planner
+	binder   *servingPackageBinder
+}
+
+func newPackageBoundPlanner(delegate plannerpkg.Planner, binder *servingPackageBinder) *packageBoundPlanner {
+	return &packageBoundPlanner{delegate: delegate, binder: binder}
+}
+
+func (p *packageBoundPlanner) Plan(ctx context.Context, runbook *parser.ParsedRunbook) (*enginepkg.ExecutionPlan, error) {
+	if err := p.binder.bind(runbook); err != nil {
+		return nil, err
+	}
+	return p.delegate.Plan(ctx, runbook)
+}
