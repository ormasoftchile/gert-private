\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Export runbook schema (default)}
gert\PYG{+w}{ }schema\PYG{+w}{ }\PYG{n+nb}{export}

\PYG{c+c1}{\PYGZsh{} Export specific schema}
gert\PYG{+w}{ }schema\PYG{+w}{ }\PYG{n+nb}{export}\PYG{+w}{ }\PYGZhy{}\PYGZhy{}kind\PYG{+w}{ }runbook\PYG{+w}{   }\PYG{c+c1}{\PYGZsh{} runbook | tool | provider | bundle}

\PYG{c+c1}{\PYGZsh{} Export full bundle (all three)}
gert\PYG{+w}{ }schema\PYG{+w}{ }\PYG{n+nb}{export}\PYG{+w}{ }\PYGZhy{}\PYGZhy{}kind\PYG{+w}{ }bundle\PYG{+w}{ }\PYGZgt{}\PYG{+w}{ }gert\PYGZhy{}v2\PYGZhy{}schemas.json

\PYG{c+c1}{\PYGZsh{} Validate a document against the exported schema}
gert\PYG{+w}{ }schema\PYG{+w}{ }\PYG{n+nb}{export}\PYG{+w}{ }\PYG{p}{|}\PYG{+w}{ }check\PYGZhy{}jsonschema\PYG{+w}{ }\PYGZhy{}\PYGZhy{}schemafile\PYG{+w}{ }\PYGZhy{}\PYG{+w}{ }runbook.yaml
\end{MintedVerbatim}
