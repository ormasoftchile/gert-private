-			onError = "continue"
+			onError = "stop"
 		}
 
 		switch {
@@ -867,8 +866,10 @@ func (h *runHandle) executeStep(ctx context.Context, step enginepkg.ResolvedStep
 			// The run will continue but the step is marked as failed
 
 		case onError == "stop":
-			// Explicit stop
-			return h.failRun(ctx, step.ID, fmt.Errorf("step %s failed", step.ID))
+			// Preserve the failed step result for the caller while making the
+			// run terminal so automatic server advancement cannot continue.
+			_, failErr := h.failRun(ctx, step.ID, fmt.Errorf("step %s failed", step.ID))
+			return result, failErr
 
 		case strings.HasPrefix(onError, "goto:"):
 			// Jump to error handler step
@@ -1839,6 +1840,12 @@ func (bh *branchHandle) executeSteps(ctx context.Context, steps []enginepkg.Reso
 		}
 		results = append(results, result)
 		if result.Status == enginepkg.StepStatusFailed {
+			// Nested branch/iterate execution has no top-level cursor for
+			// goto routing, but it must honor the explicit continuation
+			// semantics that the runbook language models.
+			if step.OnError == "continue" || (step.OnError == "" && step.ContinueOnFail) {
+				continue
+			}
 			return results, result.Error
 		}
 	}
