+  const excluded = new Set<string>();
+  const selectedDirs = [
+    ...Array.from(projectBindings.values()),
+    ...projectToolPaths,
+    ...mapToolPaths,
+  ];
+  for (const selectedDir of selectedDirs) {
+    const resolvedDir = path.isAbsolute(selectedDir)
+      ? selectedDir
+      : path.resolve(serverRoot, selectedDir);
+    mergeRegistry(registry, excluded, buildRegistryFromDir(resolvedDir));
+  }
+  return registry;
