\PYG{+w}{    }\PYG{c+c1}{// IsBusinessDay reports whether t falls on a business day (Mon–Fri, non\PYGZhy{}holiday)}
\PYG{+w}{    }\PYG{c+c1}{// in the given timezone.}
\PYG{+w}{    }\PYG{n+nx}{IsBusinessDay}\PYG{p}{(}\PYG{n+nx}{t}\PYG{+w}{ }\PYG{n+nx}{time}\PYG{p}{.}\PYG{n+nx}{Time}\PYG{p}{,}\PYG{+w}{ }\PYG{n+nx}{tz}\PYG{+w}{ }\PYG{o}{*}\PYG{n+nx}{time}\PYG{p}{.}\PYG{n+nx}{Location}\PYG{p}{)}\PYG{+w}{ }\PYG{k+kt}{bool}

