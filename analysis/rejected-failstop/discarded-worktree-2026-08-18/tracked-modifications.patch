+// ValidateVSCodeInputAdapters ensures provider-parameter mappings are only
+// declared for the VS Code bridge and refer to a typed logical action input.
+func ValidateVSCodeInputAdapters(transport schema.TransportConfig, actions map[string]*schema.ToolAction) error {
+	for actionName, action := range actions {
+		if action == nil || len(action.VSCodeInputAdapter) == 0 {
+			continue
+		}
+		if transport.Type != schema.TransportVSCodeMCP {
+			return fmt.Errorf("action %q: vscode_input_adapter is only valid for transport mode vscode-mcp (VSCODE-002)", actionName)
+		}
+		for providerParameter, binding := range action.VSCodeInputAdapter {
+			if providerParameter == "" {
+				return fmt.Errorf("action %q: vscode_input_adapter provider parameter must not be empty (VSCODE-002)", actionName)
+			}
+			if binding == nil || binding.From == "" {
+				return fmt.Errorf("action %q: vscode_input_adapter.%s.from is required (VSCODE-002)", actionName, providerParameter)
+			}
+			source, ok := action.Args[binding.From]
+			if !ok || source == nil {
+				return fmt.Errorf("action %q: vscode_input_adapter.%s.from %q is not a declared action argument (VSCODE-002)", actionName, providerParameter, binding.From)
+			}
+			switch binding.Coerce {
+			case "":
+			case "integer":
+				if source.Type != "string" {
+					return fmt.Errorf("action %q: vscode_input_adapter.%s integer coercion requires string source argument %q (VSCODE-002)", actionName, providerParameter, binding.From)
+				}
+			default:
+				return fmt.Errorf("action %q: vscode_input_adapter.%s.coerce %q is unsupported (VSCODE-002)", actionName, providerParameter, binding.Coerce)
+			}
+		}
+	}
+	return nil
+}
