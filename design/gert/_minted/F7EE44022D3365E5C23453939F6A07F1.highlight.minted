\PYG{+w}{  }run.state\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }WAITING
\PYG{+w}{  }emit\PYG{o}{(}step/waiting,\PYG{+w}{ }\PYG{o}{\PYGZob{}}event\PYGZus{}id:\PYG{+w}{ }step.event.id,\PYG{+w}{ }deadline:\PYG{+w}{ }now\PYG{o}{(}\PYG{o}{)}+step.timeout\PYG{o}{\PYGZcb{}}\PYG{o}{)}
\PYG{+w}{  }\PYG{k}{return}\PYG{+w}{ }\PYG{o}{(}suspended\PYG{o}{)}\PYG{+w}{                          }//\PYG{+w}{ }\PYG{l+m}{3}.\PYG{+w}{ }goroutine\PYG{+w}{ }exits

