\PYG{+w}{  }\PYG{n+nx}{timestamp}\PYG{p}{:}\PYG{+w}{   }\PYG{n+nx}{time}\PYG{p}{.}\PYG{n+nx}{Time}
\PYG{+w}{  }\PYG{n+nx}{notes}\PYG{p}{:}\PYG{+w}{       }\PYG{k+kt}{string}\PYG{+w}{      }\PYG{c+c1}{// optional free\PYGZhy{}text from the approver}
