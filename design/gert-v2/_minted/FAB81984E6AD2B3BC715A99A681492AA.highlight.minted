\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{n+nx}{ApprovalRecord}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{n+nx}{step\PYGZus{}id}\PYG{p}{:}\PYG{+w}{     }\PYG{k+kt}{string}
\PYG{+w}{  }\PYG{n+nx}{run\PYGZus{}id}\PYG{p}{:}\PYG{+w}{      }\PYG{k+kt}{string}
\PYG{+w}{  }\PYG{n+nx}{mode}\PYG{p}{:}\PYG{+w}{        }\PYG{n+nx}{all}\PYG{+w}{ }\PYG{o}{|}\PYG{+w}{ }\PYG{k+kt}{any}\PYG{+w}{ }\PYG{o}{|}\PYG{+w}{ }\PYG{n+nx}{quorum}
\PYG{+w}{  }\PYG{n+nx}{pool}\PYG{p}{:}\PYG{+w}{        }\PYG{p}{[}\PYG{p}{]}\PYG{k+kt}{string}\PYG{+w}{    }\PYG{c+c1}{// eligible approver role names}
\PYG{+w}{  }\PYG{n+nx}{required}\PYG{p}{:}\PYG{+w}{    }\PYG{k+kt}{int}\PYG{+w}{         }\PYG{c+c1}{// 0 = all (for mode: all / any)}
\PYG{+w}{  }\PYG{n+nx}{approvals}\PYG{p}{:}\PYG{+w}{   }\PYG{p}{[}\PYG{p}{]}\PYG{n+nx}{Approval}\PYG{+w}{  }\PYG{c+c1}{// received approvals}
\PYG{+w}{  }\PYG{n+nx}{rejections}\PYG{p}{:}\PYG{+w}{  }\PYG{p}{[}\PYG{p}{]}\PYG{n+nx}{Approval}\PYG{+w}{  }\PYG{c+c1}{// received rejections}
\PYG{p}{\PYGZcb{}}

\PYG{n+nx}{Approval}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{n+nx}{approver\PYGZus{}id}\PYG{p}{:}\PYG{+w}{ }\PYG{k+kt}{string}\PYG{+w}{      }\PYG{c+c1}{// verified identity of the submitter}
