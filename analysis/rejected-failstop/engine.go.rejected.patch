diff --git a/internal/engine/engine.go b/internal/engine/engine.go
index 98034f9..efc66f0 100644
--- a/internal/engine/engine.go
+++ b/internal/engine/engine.go
@@ -846,16 +846,15 @@ func (h *runHandle) executeStep(ctx context.Context, step enginepkg.ResolvedStep
 	if result.Status == enginepkg.StepStatusFailed {
 		h.executeCompensations(ctx, step.ID)
 
-		// Handle on_error routing
-		// Precedence: on_error > continue_on_fail > default (continue for backward compat)
+		// Handle modeled error recovery. An unhandled failure is terminal;
+		// continuation requires an explicit on_error or continue_on_fail.
+		// Precedence: on_error > continue_on_fail > default stop.
 		onError := step.OnError
 		if onError == "" && step.ContinueOnFail {
 			onError = "continue"
 		}
 		if onError == "" {
-			// Default: continue (backward compatible behavior)
